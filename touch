version: '3'

services:
  backend:
    build: ./docker/backend
    ports:
      - "5000:5000"

  frontend:
    build: ./docker/frontend
    ports:
      - "80:80"

  prometheus:
    image: prom/prometheus
    ports:
      - "9090:9090"

  grafana:
    image: grafana/grafana
    ports:
      - "3000:3000"
